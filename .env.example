# 複製成 .env(不要 commit)。前端只用得到 anon key。
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=貼上_anon_public_key

# GitHub Pages 子路徑部署時設定,例如 /travel-app/;本機留空
# VITE_BASE=/

# ── 只給 scripts/sync-notion.ts 用(放 GitHub Secrets,不進前端) ──
# 需先在 Notion 建立一個 internal integration,並把「Travel APP 內容」頁分享給它
# 各 DB ID 的實際值見私有文件 doc/Notion.md
NOTION_TOKEN=ntn_xxx
NOTION_TRIPS_DB_ID=
NOTION_ITINERARY_DB_ID=
NOTION_FLIGHTS_DB_ID=
NOTION_HOTELS_DB_ID=
NOTION_TRANSPORT_DB_ID=
NOTION_GUIDE_DB_ID=
NOTION_PHRASES_DB_ID=
